#include <stdio.h>

int main(){
	char sexo;
	float altura, pesoIdeal;
	
	printf("-------- Calculo para seu Peso Ideal: --------\n");
	
	printf("Isira sua Altura:\n");
	scanf("%f", &altura);
	
	printf("Isira seu Sexo (M/F):\n");
	scanf(" %c", &sexo);
	
	if(sexo == 'M' || sexo == 'm') {
		pesoIdeal = (72.7 * altura) - 58.0;
	} else{
		pesoIdeal = (62.1 * altura) - 44.7;
	}
	
	printf("Seu Peso Ideal e: %.2f\n", pesoIdeal);
	
	return 0;
}
